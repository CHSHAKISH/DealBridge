# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database & Queue Connections
DATABASE_URL=postgresql://dealbridge:dealbridge_password@localhost:5432/dealbridge_db?schema=public
REDIS_URL=redis://localhost:6379

# HubSpot CRM Configuration
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here
HUBSPOT_CLIENT_ID=your_hubspot_app_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_app_client_secret
HUBSPOT_WEBHOOK_SECRET=your_hubspot_webhook_verification_secret

# Zoho Books Configuration
ZOHO_CLIENT_ID=your_zoho_oauth_client_id
ZOHO_CLIENT_SECRET=your_zoho_oauth_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_oauth_refresh_token
ZOHO_ORGANIZATION_ID=your_zoho_organization_id
ZOHO_REGION=ae # UAE regional data center (.com / .in / .ae / .eu)
ZOHO_REDIRECT_URI=http://localhost:5000/api/auth/zoho/callback
ZOHO_WEBHOOK_TOKEN=your_zoho_incoming_webhook_verify_token

# Sync & Business Settings
SYNC_POLL_INTERVAL_MINUTES=15
VAT_RATE_PERCENT=5.0
DEFAULT_CURRENCY=AED

